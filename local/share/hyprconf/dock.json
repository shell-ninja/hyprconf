{
  "enabled": true,
  "mode": "smart_hide",
  "position": "bottom",
  "bg_opacity": 0.75,
  "icon_size": 32,
  "dock_padding": 8,
  "corner_radius": 16,
  "hover_effect": "subtle",
  "show_tooltips": true,
  "hide_delay": 150,
  "show_launcher": true,
  "show_indicators": true,
  "border_glow": true,
  "pinned_apps": [
    {
      "id": "kitty.desktop",
      "name": "Kitty",
      "exec": "kitty",
      "icon": "kitty",
      "icon_path": "file://~/.local/share/icons/kora/apps/scalable/kitty.svg",
      "match": ["kitty"]
    },
    {
      "id": "org.kde.dolphin.desktop",
      "name": "Dolphin",
      "exec": "dolphin",
      "icon": "org.kde.dolphin",
      "icon_path": "file://~/.local/share/icons/kora/apps/scalable/org.kde.dolphin.svg",
      "match": ["dolphin", "org.kde.dolphin"]
    }
  ]
}
