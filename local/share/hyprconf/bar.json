{
  "top_panel": "bar",
  "height": 30,
  "margin_top": 5,
  "margin_left": 10,
  "margin_right": 10,
  "padding": 8,
  "widget_spacing": 2,
  "capsule_radius": 8,
  "capsule_padding": 8,
  "capsule_style": "islands",
  "trail_style": "matrix",
  "opacity": 0.7,
  "hide_pkg_empty": false,
  "start": [
    "workspaces",
    "tray",
    "weather",
    "visualizer"
  ],
  "center": [
    "power_profile",
    "clock",
    "notification"
  ],
  "end": [
    "pkg_update",
    "quick_toggles",
    "system_info",
    "volume"
  ],
  "widget_settings": {
    "system_info": {
      "show_disk": true
    },
    "visualizer": {
      "alignment": "bottom",
      "bars": 8,
      "bar_width": 3.0,
      "spacing": 2.5,
      "hide_when_idle": false
    }
  }
}