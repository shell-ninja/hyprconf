#!/usr/bin/env python3
"""
noctalia-colors.py — Sync Noctalia Theme & Propagate to Hyprland, Kitty & Dolphin
Triggers Noctalia template generation (when explicitly changing wallpaper),
syncs the Qt6 color scheme so Dolphin picks up the new palette,
and reloads Hyprland and Kitty configurations.
"""

import json
import os
import re
import sys
import fcntl
import shutil
import subprocess
from pathlib import Path

HOME = os.getenv("HOME", str(Path.home()))
CACHE_DIR = Path(HOME) / ".hyprconf/hypr/.cache"
CURRENT_WALLPAPER = CACHE_DIR / "current_wallpaper.png"
SCRIPTS_DIR = Path(HOME) / ".hyprconf/hypr/scripts"
COLORS_SH = SCRIPTS_DIR / "colors.sh"
QS_DIR = Path(HOME) / ".hyprconf/quickshell"


def get_lock_file() -> Path:
    """Return a user-isolated lock path to prevent multi-user permission collisions."""
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
    if runtime_dir and Path(runtime_dir).is_dir():
        return Path(runtime_dir) / "noctalia_colors_sync.lock"
    uid = os.getuid()
    tmp_path = Path(f"/tmp/noctalia_colors_sync_{uid}.lock")
    try:
        tmp_path.touch(exist_ok=True)
        return tmp_path
    except Exception:
        fallback = CACHE_DIR / "noctalia_colors_sync.lock"
        fallback.parent.mkdir(parents=True, exist_ok=True)
        return fallback


def get_noctalia_colors():
    """Extract current Noctalia colors from templates and configs."""
    colors = {
        "primary": "#ac67e4",
        "secondary": "#d65cd1",
        "accent": "#ac67e4",
        "surface": "#201628",
        "background": "#201628",
        "foreground": "#f2f2f3",
        "on_primary": "#1f1825",
        "on_secondary": "#1f1825",
        "on_surface": "#f2f2f3",
        "error": "#fd4663",
        "on_error": "#1f1825",
        "muted": "#6b6372",
    }

    # 1. Parse hypr/noctalia.lua
    lua_file = Path(HOME) / ".hyprconf/hypr/noctalia.lua"
    if lua_file.exists():
        try:
            for line in lua_file.read_text().splitlines():
                m = re.match(r"local\s+([a-zA-Z0-9_]+)\s*=\s*['\"]rgb\(([a-fA-F0-9]{6})\)['\"]", line)
                if m:
                    colors[m.group(1)] = f"#{m.group(2)}"
        except Exception as e:
            print(f"Warning: Failed reading noctalia.lua: {e}", file=sys.stderr)

    # 2. Parse kitty/themes/noctalia.conf
    kitty_file = Path(HOME) / ".hyprconf/kitty/themes/noctalia.conf"
    if kitty_file.exists():
        try:
            for line in kitty_file.read_text().splitlines():
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                parts = line.split()
                if len(parts) >= 2 and parts[1].startswith("#"):
                    colors[parts[0]] = parts[1]
        except Exception as e:
            print(f"Warning: Failed reading kitty noctalia.conf: {e}", file=sys.stderr)

    # Ensure clean aliases
    colors["accent"] = colors.get("primary", "#ac67e4")
    colors["background"] = colors.get("surface", colors.get("background", "#201628"))
    colors["foreground"] = colors.get("on_surface", colors.get("foreground", "#f2f2f3"))
    colors["on_primary"] = colors.get("on_secondary", "#1f1825")
    colors["muted"] = colors.get("color8", colors.get("muted", "#6b6372"))

    return colors


def generate_shell_colors(colors=None):
    """Export Noctalia colors as bash variables in colors.sh for use across shell scripts."""
    if colors is None:
        colors = get_noctalia_colors()

    content = [
        "#!/usr/bin/env bash",
        "# ==============================================================================",
        "# colors.sh — Noctalia Dynamic Theme Palette",
        "# Auto-generated by noctalia-colors.py. Do not edit manually.",
        "# ==============================================================================",
        "",
        "# Core theme colors",
        f'primary="{colors.get("primary", "#ac67e4")}"',
        f'secondary="{colors.get("secondary", "#d65cd1")}"',
        f'accent="{colors.get("accent", "#ac67e4")}"',
        f'surface="{colors.get("surface", "#201628")}"',
        f'background="{colors.get("background", "#201628")}"',
        f'foreground="{colors.get("foreground", "#f2f2f3")}"',
        f'on_primary="{colors.get("on_primary", "#1f1825")}"',
        f'on_secondary="{colors.get("on_secondary", "#1f1825")}"',
        f'on_surface="{colors.get("on_surface", "#f2f2f3")}"',
        f'error="{colors.get("error", "#fd4663")}"',
        f'on_error="{colors.get("on_error", "#1f1825")}"',
        f'muted="{colors.get("muted", "#6b6372")}"',
        "",
        "# Terminal ANSI colors",
    ]

    for i in range(16):
        key = f"color{i}"
        if key in colors:
            content.append(f'{key}="{colors[key]}"')

    cursor_val = colors.get("cursor", "#f2f2f3")
    active_b = colors.get("active_border_color", colors.get("primary", "#ac67e4"))
    inactive_b = colors.get("inactive_border_color", colors.get("surface", "#201628"))

    content.extend([
        "",
        "# UI elements",
        f'cursor="{cursor_val}"',
        f'active_border="{active_b}"',
        f'inactive_border="{inactive_b}"',
        "",
    ])

    try:
        SCRIPTS_DIR.mkdir(parents=True, exist_ok=True)
        COLORS_SH.write_text("\n".join(content))
        os.chmod(COLORS_SH, 0o755)
        print(f"Shell colors generated: {COLORS_SH}")
    except Exception as e:
        print(f"Warning: Failed writing colors.sh: {e}", file=sys.stderr)


def sync_quickshell_colors(colors=None):
    """Generate Theme.qml, colors.json, and qmldir for Quickshell components,
    and propagate them to all subdirectories (like lockscreen and future components)."""
    if colors is None:
        colors = get_noctalia_colors()

    if not QS_DIR.exists():
        return

    theme_qml_content = f"""pragma Singleton
import QtQuick

QtObject {{
    // Noctalia Dynamic Palette
    readonly property color primary: "{colors.get('primary', '#ac67e4')}"
    readonly property color secondary: "{colors.get('secondary', '#d65cd1')}"
    readonly property color accent: "{colors.get('accent', '#ac67e4')}"
    readonly property color surface: "{colors.get('surface', '#201628')}"
    readonly property color background: "{colors.get('background', '#201628')}"
    readonly property color foreground: "{colors.get('foreground', '#f2f2f3')}"
    readonly property color on_primary: "{colors.get('on_primary', '#1f1825')}"
    readonly property color on_secondary: "{colors.get('on_secondary', '#1f1825')}"
    readonly property color on_surface: "{colors.get('on_surface', '#f2f2f3')}"
    readonly property color error: "{colors.get('error', '#fd4663')}"
    readonly property color on_error: "{colors.get('on_error', '#1f1825')}"
    readonly property color muted: "{colors.get('muted', '#6b6372')}"

    // Color helper functions
    function alpha(c, a) {{
        return Qt.rgba(c.r, c.g, c.b, a)
    }}
}}
"""

    qmldir_content = "singleton Theme 1.0 Theme.qml\n"

    try:
        QS_DIR.mkdir(parents=True, exist_ok=True)
        config_qs = Path(HOME) / ".config/quickshell"
        if not config_qs.exists() and QS_DIR.exists():
            try:
                config_qs.parent.mkdir(parents=True, exist_ok=True)
                config_qs.symlink_to(QS_DIR)
            except Exception:
                pass

        config_hypr = Path(HOME) / ".config/hypr"
        hyprconf_hypr = Path(HOME) / ".hyprconf/hypr"
        if not config_hypr.exists() and hyprconf_hypr.exists():
            try:
                config_hypr.parent.mkdir(parents=True, exist_ok=True)
                config_hypr.symlink_to(hyprconf_hypr)
            except Exception:
                pass

        # 1. Write root Theme.qml, qmldir, and colors.json
        (QS_DIR / "Theme.qml").write_text(theme_qml_content)
        (QS_DIR / "qmldir").write_text(qmldir_content)
        (QS_DIR / "colors.json").write_text(json.dumps(colors, indent=2) + "\n")

        # Subproject qmldir definitions
        SUBPROJECT_QMLDIRS = {
            "settings": """singleton Theme 1.0 Theme.qml
BezierGraph 1.0 BezierGraph.qml
CapsuleSwitch 1.0 CapsuleSwitch.qml
ModernSlider 1.0 ModernSlider.qml
ModernDropdown 1.0 ModernDropdown.qml
SettingCard 1.0 SettingCard.qml
DraggableWidget 1.0 DraggableWidget.qml
LockscreenSection 1.0 LockscreenSection.qml
""",
            "launcher": """singleton Theme 1.0 Theme.qml
Style1 1.0 Style1.qml
Style2 1.0 Style2.qml
""",
            "launcher-theme": """singleton Theme 1.0 Theme.qml
""",
        }

        # 2. Propagate Theme.qml and custom qmldir into all subdirectories
        for item in QS_DIR.iterdir():
            if item.is_dir() and not item.name.startswith("."):
                sub_theme = item / "Theme.qml"
                sub_qmldir = item / "qmldir"

                if not sub_theme.is_symlink() or (os.path.islink(sub_theme) and os.readlink(sub_theme) != "../Theme.qml"):
                    sub_theme.unlink(missing_ok=True)
                    sub_theme.symlink_to("../Theme.qml")

                if item.name in SUBPROJECT_QMLDIRS:
                    expected_content = SUBPROJECT_QMLDIRS[item.name]
                    # If it's a symlink or has wrong content, write the expected file
                    if sub_qmldir.is_symlink() or not sub_qmldir.exists() or sub_qmldir.read_text() != expected_content:
                        sub_qmldir.unlink(missing_ok=True)
                        sub_qmldir.write_text(expected_content)
                else:
                    if not sub_qmldir.exists():
                        sub_qmldir.symlink_to("../qmldir")

        print(f"Quickshell colors synced: {QS_DIR}/Theme.qml")
    except Exception as e:
        print(f"Warning: Quickshell color sync failed: {e}", file=sys.stderr)


def sync_qt6ct_colors():
    """Copy the noctalia qt6ct color scheme to the live config directory
    so Dolphin and other Qt6 apps always use the current palette."""
    src = Path(HOME) / ".hyprconf/qt6ct/colors/noctalia.conf"
    dst_dir = Path(HOME) / ".config/qt6ct/colors"
    dst = dst_dir / "noctalia.conf"
    try:
        dst_dir.mkdir(parents=True, exist_ok=True)
        if src.exists():
            shutil.copy2(src, dst)
            print(f"Qt6ct color scheme synced: {dst}")
    except shutil.SameFileError:
        pass
    except Exception as e:
        print(f"Warning: Qt6ct color sync failed: {e}", file=sys.stderr)

    # Also fix the color_scheme_path in case it ever has the wrong username
    qt6ct_conf = Path(HOME) / ".config/qt6ct/qt6ct.conf"
    correct_path = str(dst)
    if qt6ct_conf.exists():
        try:
            text = qt6ct_conf.read_text()
            text = re.sub(
                r"^color_scheme_path=.*$",
                f"color_scheme_path={correct_path}",
                text,
                flags=re.MULTILINE,
            )
            qt6ct_conf.write_text(text)
        except Exception as e:
            print(f"Warning: qt6ct.conf path fix failed: {e}", file=sys.stderr)


def notify_kde_reload():
    """Signal running Qt/KDE apps (e.g. Dolphin) to reload their color palette via DBus."""
    try:
        subprocess.run(
            [
                "dbus-send", "--session", "--type=signal",
                "/KGlobalSettings", "org.kde.KGlobalSettings.notifyChange",
                "int32:3", "int32:0",
            ],
            capture_output=True, timeout=3,
        )
    except Exception:
        pass


def sync_noctalia_theme(wallpaper_path=None, explicit_change=False):
    # Only set wallpaper and trigger template generation if explicitly requested
    # (e.g. via command-line argument or WallpaperSelect).
    # When called as a hook (colors_changed), Noctalia has ALREADY changed colors
    # and applied templates — calling wallpaper-set or templates-apply here would
    # cause an infinite recursion loop!
    if explicit_change and wallpaper_path and os.path.exists(wallpaper_path):
        try:
            subprocess.run(
                ["noctalia", "msg", "wallpaper-set", wallpaper_path],
                capture_output=True,
                text=True,
                timeout=5,
            )
        except Exception as e:
            print(f"Warning: Noctalia wallpaper-set failed: {e}", file=sys.stderr)

        try:
            subprocess.run(
                ["noctalia", "msg", "templates-apply"],
                capture_output=True,
                text=True,
                timeout=5,
            )
        except Exception as e:
            print(f"Warning: Noctalia templates-apply failed: {e}", file=sys.stderr)

    # Get colors once
    colors = get_noctalia_colors()

    # Generate colors.sh for shell scripts and gum
    generate_shell_colors(colors)

    # Sync Quickshell components (Theme.qml, qmldir, colors.json)
    sync_quickshell_colors(colors)

    # Sync qt6ct color scheme so Dolphin picks up the new palette
    sync_qt6ct_colors()

    # Reload Hyprland configuration to update border colors
    subprocess.run(["hyprctl", "reload", "config-only"], capture_output=True)

    # Send SIGUSR1 to reload running Kitty instances
    subprocess.run("killall -SIGUSR1 kitty 2>/dev/null || true", shell=True)

    # Notify KDE/Qt apps (Dolphin, etc.) to reload their color palette via DBus
    notify_kde_reload()

    print("Noctalia colors applied and desktop reloaded.")


def main():
    # Use user-isolated lock to avoid multi-user permission collisions
    lock_file = get_lock_file()
    try:
        lock_fd = os.open(str(lock_file), os.O_CREAT | os.O_RDWR, 0o600)
    except PermissionError:
        fallback = CACHE_DIR / "noctalia_colors_sync.lock"
        fallback.parent.mkdir(parents=True, exist_ok=True)
        lock_fd = os.open(str(fallback), os.O_CREAT | os.O_RDWR, 0o600)

    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        # Another instance is already syncing colors, skip
        sys.exit(0)

    try:
        explicit_change = False
        wall = None
        if len(sys.argv) > 1 and os.path.exists(sys.argv[1]):
            wall = sys.argv[1]
            explicit_change = True

        sync_noctalia_theme(wall, explicit_change=explicit_change)
    finally:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_UN)
            os.close(lock_fd)
        except Exception:
            pass


if __name__ == "__main__":
    main()
